# Copy to `.env` (cp env.sample .env) and fill in real values before `docker compose up`.
# docker-compose refuses to start until the required (?-marked) variables below are set.

# --- Required secrets --------------------------------------------------------
# Unique, random, >= 32 characters. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=

# Database / cache / broker passwords (pick strong random values).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# --- Optional overrides (sensible defaults shown) ----------------------------
# POSTGRES_USER=ghostlab
# POSTGRES_DB=ghostlab
# RABBITMQ_USER=topinjector

# Set to true once the panel is served over HTTPS (auth cookies then require Secure).
# COOKIE_SECURE=false

# Comma-separated emails allowed to open /api/projects/admin/stats (empty = nobody).
# ADMIN_EMAILS=
